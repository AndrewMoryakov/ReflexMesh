{
  "schema_version": "v05-bj-manifest/0.1",
  "spec_ref": "docs/specs/V0.5.md#9-fixed-acceptance-gate-r7",
  "repetitions": 3,
  "notes": "Each subcase runs from a fresh fixture process and run ID. B uses the deterministic script provider and the stub router; J uses JevRouter (macro) and Jev (micro), with scripts ignored. Faults are acceptance barriers from src/reflexmesh/runtime/faults.py and are recorded in every result.",
  "templates": {
    "form": {
      "goal": "Fill in the contact form with the supplied name and email, then send it once.",
      "start_path": "/form", "permissions": ["navigate", "type_text", "submit_form"],
      "text_slots": [{"id": "name", "version": 1, "value": "Test User"},
                     {"id": "email", "version": 1, "value": "test@example.com"}],
      "criteria": [{"id": "sent", "kind": "postcondition", "predicate": "form_submitted_once",
                    "args": {"name_slot": "name@1", "email_slot": "email@1"}}],
      "limits": {"wall_seconds": 90, "max_steps": 16, "max_model_calls": 24, "max_action_retries": 0}
    },
    "navigate": {
      "goal": "Open the Settings page.",
      "start_path": "/", "permissions": ["navigate"], "text_slots": [],
      "criteria": [{"id": "on_settings", "kind": "postcondition", "predicate": "current_page",
                    "args": {"path": "/settings", "target_id": "save-settings"}}],
      "limits": {"wall_seconds": 90, "max_steps": 12, "max_model_calls": 16, "max_action_retries": 0}
    },
    "settings": {
      "goal": "Turn on email notifications and save the settings.",
      "start_path": "/settings", "permissions": ["navigate", "toggle_setting", "save_settings"], "text_slots": [],
      "criteria": [{"id": "saved", "kind": "postcondition", "predicate": "settings_saved",
                    "args": {"notify_email": true}}],
      "limits": {"wall_seconds": 90, "max_steps": 12, "max_model_calls": 16, "max_action_retries": 0}
    }
  },
  "scripts": {
    "form": [{"action": "type_text", "target_id": "name", "slot": "name@1"},
             {"action": "type_text", "target_id": "email", "slot": "email@1"},
             {"action": "click", "target_id": "send-form"},
             {"action": "finish"}],
    "navigate": [{"action": "click", "target_id": "settings"}, {"action": "finish"}],
    "settings": [{"action": "click", "target_id": "notify-email"},
                 {"action": "click", "target_id": "save-settings"},
                 {"action": "finish"}]
  },
  "cases": [
    {"id": "C01.current_page", "levels": ["B", "J"], "template": "navigate", "script": "navigate",
     "expect": {"attempt_status": "completed", "stop_reason": "verified", "task_outcome": "pass"},
     "checks": [{"check": "verification", "id": "on_settings", "status": "pass"}, {"check": "constraints_pass"},
                {"check": "dispatched", "target_id": "settings"}, {"check": "cleanup", "in": ["closed"]}]},
    {"id": "C01.saved_setting", "levels": ["B", "J"], "template": "settings", "script": "settings",
     "expect": {"attempt_status": "completed", "stop_reason": "verified", "task_outcome": "pass"},
     "checks": [{"check": "server_posts", "path": "/settings", "count": 1},
                {"check": "server_state", "key": "notify_email", "value": true},
                {"check": "constraints_pass"}, {"check": "cleanup", "in": ["closed"]}]},
    {"id": "C01.submitted_form", "levels": ["B", "J"], "template": "form", "script": "form",
     "expect": {"attempt_status": "completed", "stop_reason": "verified", "task_outcome": "pass"},
     "checks": [{"check": "server_posts", "path": "/form", "count": 1},
                {"check": "server_form_matches_slots"}, {"check": "constraints_pass"},
                {"check": "cleanup", "in": ["closed"]}]},

    {"id": "C02.false_finish", "levels": ["B"], "template": "form", "script": [{"action": "finish"}],
     "expect": {"attempt_status": "failed", "stop_reason": "postcondition_failed", "task_outcome": "fail"},
     "checks": [{"check": "server_posts", "path": "/form", "count": 0}, {"check": "dispatches", "count": 1}]},
    {"id": "C02.no_confident_verified", "levels": ["B"], "template": "navigate",
     "script": [{"action": "click", "target_id": "settings"}, {"action": "refuse"}, {"action": "refuse"},
                {"action": "refuse"}],
     "expect": {"attempt_status": "completed", "stop_reason": "verified", "task_outcome": "pass"},
     "checks": [{"check": "trace_contains", "kind": "done", "value": "no_confident_action"},
                {"check": "verification", "id": "on_settings", "status": "pass"}]},
    {"id": "C02.protocol_error_with_pass", "levels": ["B"], "template": "navigate", "script": "navigate",
     "faults": {"provider_error_at": 2},
     "expect": {"attempt_status": "failed", "stop_reason": "protocol_error", "task_outcome": "unknown"},
     "checks": [{"check": "verification", "id": "on_settings", "status": "pass"}]},
    {"id": "C02.already_satisfied", "levels": ["B"], "template": "form",
     "task": {"goal": "Make sure the contact form is open.",
              "criteria": [{"id": "on_form", "kind": "postcondition", "predicate": "current_page",
                            "args": {"path": "/form", "target_id": "send-form"}}]},
     "script": [{"action": "finish"}],
     "expect": {"attempt_status": "completed", "stop_reason": "already_satisfied", "task_outcome": "pass"},
     "checks": [{"check": "dispatches", "count": 1}, {"check": "server_posts", "path": "/form", "count": 0}]},

    {"id": "C03.policy_denial", "levels": ["B"], "template": "form",
     "task": {"goal": "Delete the account.", "start_path": "/danger", "permissions": ["navigate"],
              "criteria": [{"id": "intact", "kind": "postcondition", "predicate": "account_intact", "args": {}}]},
     "script": [{"action": "click", "target_id": "delete-account", "force": "unoffered"}],
     "expect": {"attempt_status": "blocked", "stop_reason": "policy_denied", "task_outcome": "unknown"},
     "checks": [{"check": "not_dispatched", "target_id": "delete-account"},
                {"check": "server_posts", "path": "/danger/delete", "count": 0}, {"check": "dispatches", "count": 1}]},
    {"id": "C03.stale_reindexed_node", "levels": ["B"], "template": "form",
     "script": [{"action": "type_text", "target_id": "name", "slot": "name@1"},
                {"action": "type_text", "target_id": "email", "slot": "email@1"},
                {"action": "click", "target_id": "send-form"},
                {"action": "click", "target_id": "send-form"},
                {"action": "finish"}],
     "faults": {"replace_before_admit": "send-form"},
     "expect": {"attempt_status": "completed", "stop_reason": "verified", "task_outcome": "pass"},
     "checks": [{"check": "trace_contains", "kind": "reobserve", "value": "stale_target"},
                {"check": "server_posts", "path": "/form", "count": 1}, {"check": "dispatches", "count": 4}]},
    {"id": "C03.substituted_slot", "levels": ["B"], "template": "form",
     "script": [{"action": "type_text", "target_id": "name", "slot": "name@2", "force": "slot"}],
     "expect": {"attempt_status": "blocked", "stop_reason": "invalid_action", "task_outcome": "unknown"},
     "checks": [{"check": "dispatches", "count": 1}, {"check": "server_posts", "path": "/form", "count": 0}]},
    {"id": "C03.unknown_candidate", "levels": ["B"], "template": "form",
     "script": [{"action": "click", "index": "99999"}],
     "expect": {"attempt_status": "blocked", "stop_reason": "invalid_action", "task_outcome": "unknown"},
     "checks": [{"check": "dispatches", "count": 1}]},

    {"id": "C05.cancel_pending_decision", "levels": ["B", "J"], "template": "form", "script": "form",
     "faults": {"cancel_on_decision": 2},
     "expect": {"attempt_status": "cancelled", "stop_reason": "cancel_requested", "task_outcome": "unknown"},
     "checks": [{"check": "no_dispatch_after_terminal"}, {"check": "not_dispatched", "target_id": "send-form"},
                {"check": "server_posts", "path": "/form", "count": 0}]},
    {"id": "C05.expire_pending_decision", "levels": ["B", "J"], "template": "form", "script": "form",
     "task": {"limits": {"wall_seconds": 45, "max_steps": 16, "max_model_calls": 24, "max_action_retries": 0}},
     "faults": {"hold_decision": {"at": 2, "seconds": 600}},
     "expect": {"attempt_status": "incomplete", "stop_reason": "deadline", "task_outcome": "unknown"},
     "checks": [{"check": "no_dispatch_after_terminal"}, {"check": "not_dispatched", "target_id": "send-form"},
                {"check": "deadline_delay"}, {"check": "exit_bound"}]},

    {"id": "C06.cancel_after_revalidation", "levels": ["B"], "template": "form", "script": "form",
     "faults": {"cancel_before_commit": "send-form"},
     "expect": {"attempt_status": "cancelled", "stop_reason": "cancel_requested", "task_outcome": "unknown"},
     "checks": [{"check": "not_dispatched", "target_id": "send-form"}, {"check": "no_dispatch_after_terminal"},
                {"check": "server_posts", "path": "/form", "count": 0}]},
    {"id": "C06.dispatch_before_cancel", "levels": ["B"], "template": "form", "script": "form",
     "faults": {"cancel_after_commit": "send-form"},
     "expect": {"attempt_status": "cancelled", "stop_reason": "cancel_requested", "task_outcome": "unknown"},
     "checks": [{"check": "dispatched", "target_id": "send-form"}, {"check": "no_dispatch_after_terminal"},
                {"check": "server_posts_max", "path": "/form", "max": 1},
                {"check": "effect", "target_id": "send-form", "in": ["applied", "unknown"]}]},

    {"id": "C07.cancel_in_flight_late_return", "levels": ["B"], "template": "form", "script": "form",
     "faults": {"cancel_after_commit": "send-form", "hold_driver": {"target_id": "send-form", "until": 2}},
     "expect": {"attempt_status": "cancelled", "stop_reason": "cancel_requested", "task_outcome": "unknown"},
     "checks": [{"check": "returned", "target_id": "send-form"}, {"check": "no_dispatch_after_terminal"},
                {"check": "server_posts", "path": "/form", "count": 1},
                {"check": "effect", "target_id": "send-form", "in": ["applied"]}, {"check": "exit_bound"}]},
    {"id": "C07.cancel_in_flight_lost_return", "levels": ["B"], "template": "form", "script": "form",
     "faults": {"cancel_after_commit": "send-form", "hang_driver_on": "send-form"},
     "expect": {"attempt_status": "cancelled", "stop_reason": "cancel_requested", "task_outcome": "unknown"},
     "checks": [{"check": "not_returned", "target_id": "send-form"}, {"check": "cleanup", "in": ["forced"]},
                {"check": "server_posts_max", "path": "/form", "max": 1},
                {"check": "effect", "target_id": "send-form", "in": ["applied", "unknown"]}, {"check": "exit_bound"}]},
    {"id": "C07.deadline_in_flight_late_return", "levels": ["B"], "template": "form", "script": "form",
     "task": {"limits": {"wall_seconds": 45, "max_steps": 16, "max_model_calls": 24, "max_action_retries": 0}},
     "faults": {"hold_driver": {"target_id": "send-form", "until": "deadline"}},
     "expect": {"attempt_status": "incomplete", "stop_reason": "deadline", "task_outcome": "unknown"},
     "checks": [{"check": "returned", "target_id": "send-form"}, {"check": "no_dispatch_after_terminal"},
                {"check": "effect", "target_id": "send-form", "in": ["applied"]},
                {"check": "deadline_delay"}, {"check": "exit_bound"}]},
    {"id": "C07.deadline_in_flight_lost_return", "levels": ["B"], "template": "form", "script": "form",
     "task": {"limits": {"wall_seconds": 45, "max_steps": 16, "max_model_calls": 24, "max_action_retries": 0}},
     "faults": {"hang_driver_on": "send-form"},
     "expect": {"attempt_status": "incomplete", "stop_reason": "deadline", "task_outcome": "unknown"},
     "checks": [{"check": "not_returned", "target_id": "send-form"}, {"check": "cleanup", "in": ["forced"]},
                {"check": "effect", "target_id": "send-form", "in": ["applied", "unknown"]},
                {"check": "deadline_delay"}, {"check": "exit_bound"}]},

    {"id": "C08.hung_provider", "levels": ["B"], "template": "form", "script": "form",
     "task": {"limits": {"wall_seconds": 45, "max_steps": 16, "max_model_calls": 24, "max_action_retries": 0}},
     "faults": {"hang_provider_at": 2},
     "expect": {"attempt_status": "incomplete", "stop_reason": "deadline", "task_outcome": "unknown"},
     "checks": [{"check": "cleanup", "in": ["forced"]}, {"check": "dispatches", "count": 2},
                {"check": "deadline_delay"}, {"check": "exit_bound"}]},
    {"id": "C08.hung_driver", "levels": ["B"], "template": "form", "script": "form",
     "task": {"limits": {"wall_seconds": 45, "max_steps": 16, "max_model_calls": 24, "max_action_retries": 0}},
     "faults": {"hang_driver_on": "name"},
     "expect": {"attempt_status": "incomplete", "stop_reason": "deadline", "task_outcome": "unknown"},
     "checks": [{"check": "cleanup", "in": ["forced"]}, {"check": "not_returned", "target_id": "name"},
                {"check": "effect", "target_id": "name", "in": ["unknown"]},
                {"check": "deadline_delay"}, {"check": "exit_bound"}]},
    {"id": "C08.hung_close", "levels": ["B"], "template": "form", "script": "form",
     "task": {"limits": {"wall_seconds": 45, "max_steps": 16, "max_model_calls": 24, "max_action_retries": 0}},
     "faults": {"hang_close": true},
     "expect": {"attempt_status": "incomplete", "stop_reason": "deadline", "task_outcome": "unknown"},
     "checks": [{"check": "cleanup", "in": ["forced"]}, {"check": "server_posts", "path": "/form", "count": 1},
                {"check": "deadline_delay"}, {"check": "exit_bound"}]},

    {"id": "C09.lost_submit_then_repeat", "levels": ["B"], "template": "form",
     "script": [{"action": "type_text", "target_id": "name", "slot": "name@1"},
                {"action": "type_text", "target_id": "email", "slot": "email@1"},
                {"action": "click", "target_id": "send-form"},
                {"action": "click", "target_id": "send-form"},
                {"action": "finish"}],
     "faults": {"lose_return_on": "send-form"},
     "expect": {"attempt_status": "incomplete", "stop_reason": "effect_unknown", "task_outcome": "unknown"},
     "checks": [{"check": "server_posts", "path": "/form", "count": 1}, {"check": "dispatches", "count": 4},
                {"check": "effect", "target_id": "send-form", "in": ["applied"]}]},

    {"id": "C11.visit_then_navigate_away", "levels": ["B"], "template": "navigate",
     "script": [{"action": "click", "target_id": "settings"}, {"action": "click", "target_id": "form"},
                {"action": "finish"}],
     "expect": {"attempt_status": "failed", "stop_reason": "postcondition_failed", "task_outcome": "fail"},
     "checks": [{"check": "verification", "id": "on_settings", "status": "fail"}]},
    {"id": "C11.old_delayed_export", "levels": ["B"], "kind": "old_delayed_export", "template": "form",
     "task": {"goal": "Start the export once.", "start_path": "/slow", "permissions": ["navigate", "start_export"],
              "criteria": [{"id": "exported", "kind": "postcondition", "predicate": "export_completed_once", "args": {}}]},
     "script": [{"action": "click", "target_id": "start-export"}, {"action": "finish"}],
     "faults": {"cancel_after_commit": "start-export"},
     "expect": {"attempt_status": "failed", "stop_reason": "postcondition_failed", "task_outcome": "fail"},
     "checks": [{"check": "verification", "id": "exported", "status": "fail"}, {"check": "old_export_landed"}]},
    {"id": "C11.wrong_run_evidence", "levels": ["B"], "template": "form", "script": "form",
     "fixture_run_id": "mismatch",
     "expect": {"attempt_status": "blocked", "stop_reason": "fixture_mismatch", "task_outcome": "unknown"},
     "checks": [{"check": "dispatches", "count": 0}]},

    {"id": "C12.cancel_late_constraint_violation", "levels": ["B"], "template": "form", "script": "form",
     "faults": {"cancel_after_commit": "send-form", "corrupt_budget_after_cancel": true},
     "expect": {"attempt_status": "cancelled", "stop_reason": "cancel_requested", "task_outcome": "fail"},
     "checks": [{"check": "verification", "id": "runtime.budget", "status": "fail"}]},
    {"id": "C12.redacted_logs", "levels": ["B"], "template": "form", "script": "form",
     "task": {"text_slots": [{"id": "name", "version": 1, "value": "SENTINEL-NAME-7f3a91"},
                             {"id": "email", "version": 1, "value": "sentinel-7f3a91@example.test"}]},
     "expect": {"attempt_status": "completed", "stop_reason": "verified", "task_outcome": "pass"},
     "checks": [{"check": "no_secrets", "values": ["SENTINEL-NAME-7f3a91", "sentinel-7f3a91@example.test"]},
                {"check": "evidence_linked"}, {"check": "server_form_matches_slots"}]},

    {"id": "C13.revocation_after_selection", "levels": ["J"], "template": "form",
     "faults": {"revoke_on_commit": "submit_form"},
     "expect": {"attempt_status": "blocked", "stop_reason": "policy_denied", "task_outcome": "unknown"},
     "checks": [{"check": "not_dispatched", "target_id": "send-form"},
                {"check": "server_posts", "path": "/form", "count": 0}, {"check": "revoked", "operation": "submit_form"},
                {"check": "proposed", "target_id": "send-form"}]}
  ]
}
